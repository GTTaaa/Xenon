{
  "name": "xenon",
  "version": "1.0.3",
  "description": "Xenon — 本地 OCR、流式译文的桌面截图翻译器",
  "main": "./out/main/index.js",
  "author": "GTTaaa",
  "license": "MIT",
  "homepage": "https://github.com/GTTaaa/Xenon",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "release:mac": "node scripts/release-mac.mjs",
    "release:mac:patch": "node scripts/release-mac.mjs --bump patch",
    "release:mac:minor": "node scripts/release-mac.mjs --bump minor",
    "release:mac:major": "node scripts/release-mac.mjs --bump major",
    "build:linux": "pnpm run build && electron-builder --linux",
    "build:ocr": "mkdir -p resources/bin && swiftc -O -o resources/bin/mac-vision-ocr src/main/native/mac-ocr/main.swift",
    "verify:ocr-cold": "node scripts/verify-ocr-cold.mjs",
    "verify:ocr-engine": "node scripts/verify-ocr-engine.mjs",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.6",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
