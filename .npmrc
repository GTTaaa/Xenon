# 仅保留 electron-builder 二进制镜像。electron 镜像统一由 electron-builder.yml 的
# electronDownload.mirror 提供，切勿在此处设置 electron_mirror：它会以
# npm_config_electron_mirror 环境变量注入，优先于 mirrorOptions，劫持 dmg-builder 等
# 其它二进制的下载地址，导致 404。
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
shamefully-hoist=true
